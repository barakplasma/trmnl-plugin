{% comment %} Builds the board once; each layout prints it. Sized by `size`. Hebrew, right to left. {% endcomment %}
{% assign max_stops = 2 %}{% assign max_lines = 6 %}{% assign max_arrivals = 3 %}{% assign stacked = false %}
{% case size %}
  {% when 'half_horizontal' %}{% assign max_lines = 2 %}{% assign max_arrivals = 2 %}
  {% when 'half_vertical' %}{% assign max_lines = 2 %}{% assign max_arrivals = 2 %}{% assign stacked = true %}
  {% when 'quadrant' %}{% assign max_stops = 1 %}{% assign max_lines = 2 %}{% assign max_arrivals = 2 %}
{% endcase %}
{% capture board %}
{% comment %} TRMNL's fonts have no Hebrew; BYOS waits for network idle, so the web font is loaded before the screenshot. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;600;700&display=block">
<style>
  .ib, .ib .title, .ib .label, .ib .value, .ib .description { font-family: "Noto Sans Hebrew", sans-serif; }
  .ib .min { font-weight: 700; }
  .ib .arr { display: flex; gap: 0 14px; flex-wrap: wrap; }
  .ib .title--small { align-self: stretch; text-align: right; }
  .title_bar.ib .instance { text-align: left; font-family: "Noto Sans Hebrew", sans-serif; }
</style>
<div class="layout ib {% if stacked %}layout--col{% else %}layout--row{% endif %} layout--top gap--medium" dir="rtl" lang="he">
{% if error %}
  <span class="label">שרת האוטובוסים לא זמין ({{ error }})</span>
{% elsif stops == nil or stops.size == 0 %}
  <span class="label">יש להגדיר תחנת עלייה בהגדרות התוסף</span>
{% else %}
  {% for stop in stops limit: max_stops %}
    <div class="layout layout--col layout--top gap--small w--full">
      <span class="title title--small clamp--1">{% assign from = stop.name | split: '/' | first %}{% assign to = stop.to_name | split: '/' | first %}{{ stop.label | default: from | default: stop.code }}{% if to %} ← {{ to }}{% endif %}</span>
      {% if stop.error %}
        <span class="label">{{ stop.error }}</span>
      {% elsif stop.lines.size == 0 %}
        <span class="label">אין יציאות קרובות</span>
      {% else %}
        {% for l in stop.lines limit: max_lines %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <div class="flex gap--small">
              <span class="value value--small">{{ l.line }}</span>
              {% unless size == 'quadrant' %}<span class="label label--small clamp--1">ל{{ l.direction }}</span>{% endunless %}
            </div>
            <span class="label arr">{% for a in l.arrivals limit: max_arrivals %}<span dir="rtl"><span class="min">{% if a.min == 0 %}עכשיו{% else %}{{ a.min }} ד׳{% endif %}</span> <bdi dir="ltr">{% unless a.realtime %}~{% endunless %}{{ a.at }}</bdi></span>{% endfor %}</span>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
{% endif %}
</div>
<div class="title_bar ib" dir="rtl" lang="he">
  <span class="title">{{ config.trip_title | default: 'אוטובוסים' }}</span>
  <span class="instance">{% if updated %}עודכן <span dir="ltr">{{ updated }}</span> · <span dir="ltr">~</span> לפי לוח זמנים{% endif %}</span>
</div>
{% endcapture %}
