{% comment %} The israel-bus service sends data only (departures, ruler, later); these templates draw the Hebrew, right-to-left board for every size. {% endcomment %}
{% capture board %}{% if stops %}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;600;700&family=Noto+Color+Emoji&display=block">
<style>
  /* TRMNL's fonts have no Hebrew, and BYOS's Alpine Chromium may have no emoji font; BYOS waits for network idle, so both load before the screenshot. */
  .ib, .ib .title, .ib .label, .ib .value, .title_bar.ib .instance { font-family: "Noto Sans Hebrew", "Noto Color Emoji", sans-serif; }
  .ib-board { display: flex; flex-direction: row; align-items: stretch; gap: 16px; }
  .ib-stop { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .ib-head { align-self: stretch; text-align: right; }
  /* Time blindness: one row per bus, ruled apart; the next bus is a black block */
  .ib-deps { display: flex; flex-direction: column; border-top: 3px solid #000; }
  .ib-dep { display: flex; align-items: center; gap: 10px; padding: 3px 8px; border-bottom: 2px solid #000; color: #000; }
  .ib-dep:first-child { color: #fff; padding: 6px 8px; gap: 8px; }
  .ib-time { font-weight: 700; font-size: 30px; line-height: 1.1; width: 96px; flex: none; text-align: right; }
  .ib-dep:first-child .ib-time { font-size: 40px; width: 112px; }
  .ib-badge { flex: none; min-width: 52px; padding: 0 8px; text-align: center; font-weight: 700; font-size: 20px; line-height: 1.4; border: 3px solid currentColor; border-radius: 8px; color: inherit; }
  .ib-badge.ib-fill { background: #000; color: #fff; }
  .ib-dep:first-child .ib-badge.ib-fill { background: #fff; color: #000; }
  .ib-min { flex: none; margin-inline-start: auto; font-weight: 700; font-size: 18px; min-width: 40px; text-align: left; white-space: nowrap; color: inherit; }
  /* Color for tablets; the black/white structure below carries it on e-ink (all four are dark enough to stay readable in gray). */
  .ib-t0 { --tc: #a50f1a; } .ib-t1 { --tc: #a14a08; } .ib-t2 { --tc: #12692b; } .ib-t3 { --tc: #1c43a8; }
  .ib-dep:first-child, .ib-pin:first-child .ib-pt { background: var(--tc, #000); }
  .ib-dep:not(:first-child) .ib-time, .ib-pin:not(:first-child) .ib-pt { color: var(--tc, #000); }
  .ib-bus { flex: none; font-size: 15px; font-weight: 600; direction: ltr; opacity: .85; }
  .ib-emo { flex: none; font-size: 26px; width: 34px; text-align: center; }
  .title_bar.ib .instance { text-align: left; }
  /* Full layout: one ruler of when to leave, now at the right; the rows above are for the smaller sizes. */
  .ib-ruler { display: none; flex-direction: column; align-items: stretch; gap: 6px; }
  .view--full .ib-board { display: none; }
  .view--full .ib-ruler { display: flex; }
  .ib-rarea { position: relative; height: 310px; margin: 0 56px; }
  .ib-pin { position: absolute; transform: translateX(50%); text-align: center; white-space: nowrap; line-height: 1.05; }
  .ib-pt { display: block; font-weight: 700; font-size: 38px; padding: 0 8px; border-radius: 8px; direction: ltr; }
  .ib-pin:first-child .ib-pt { color: #fff; }
  .ib-pin .ib-badge { font-size: 17px; }
  .ib-axis { position: relative; height: 6px; margin: 0 56px; background: #000; }
  .ib-tk { position: absolute; top: -8px; width: 3px; height: 22px; background: #000; transform: translateX(50%); }
  .ib-tl { position: absolute; top: 16px; font-size: 16px; font-weight: 700; transform: translateX(50%); white-space: nowrap; }
  .ib-later { margin-top: 22px; font-size: 20px; font-weight: 700; }
  /* One payload serves every size; BYOS wraps each layout in .view--{size}. */
  .view--half_vertical .ib-board { flex-direction: column; }
  .view--half_vertical .ib-stop { flex: none; width: 100%; }
  .view--quadrant .ib-stop:nth-of-type(n+2) { display: none; }
  .view--half_horizontal .ib-dep:nth-of-type(n+4),
  .view--half_vertical .ib-dep:nth-of-type(n+4),
  .view--quadrant .ib-dep:nth-of-type(n+4) { display: none; }
</style>
<div class="layout ib ib-board" dir="rtl" lang="he">
{% if stops.size == 0 %}
  <span class="label">יש להגדיר תחנת עלייה בהגדרות התוסף</span>
{% endif %}
{% for stop in stops %}
  <div class="ib-stop">
    <span class="title title--small clamp--1 ib-head">{{ stop.header }}</span>
    {% if stop.error %}
    <span class="label">{{ stop.error }}</span>
    {% elsif stop.departures.size == 0 %}
    <span class="label">אין יציאות קרובות</span>
    {% endif %}
    <div class="ib-deps">
      {% for d in stop.departures %}
      <div class="ib-dep ib-t{{ d.tier }}">
        <span class="ib-emo">{{ d.emoji }}</span>
        <span class="ib-time" dir="ltr">{% unless d.realtime %}~{% endunless %}{{ d.at }}</span>
        <span class="ib-badge{% unless d.line == "שאטל" %} ib-fill{% endunless %}">{{ d.line }}</span>
        {% if d.bus != d.at %}<span class="ib-bus">🚌 {{ d.bus }}</span>{% endif %}
        <span class="ib-min">{% if d.min == 0 %}עכשיו{% else %}{{ d.min }} ד׳{% endif %}</span>
      </div>
      {% endfor %}
    </div>
  </div>
{% endfor %}
</div>
<div class="layout ib ib-ruler" dir="rtl" lang="he">
  <span class="title title--small ib-head">🚪 לצאת מהדלת{% if walks != "" %} · הליכה {{ walks }} ד׳{% endif %}</span>
  {% for stop in stops %}{% if stop.error %}
  <span class="label">{{ stop.header }}: {{ stop.error }}</span>
  {% endif %}{% endfor %}
  <div class="ib-rarea">
    {% for d in ruler %}
    <div class="ib-pin ib-t{{ d.tier }}" style="right:{{ d.pos }}%;bottom:{{ d.bottom }}px">
      <span class="ib-pt">{% unless d.realtime %}~{% endunless %}{{ d.at }}</span>
      <span class="ib-badge{% unless d.line == "שאטל" %} ib-fill{% endunless %}">{{ d.line }}</span>
    </div>
    {% else %}
    <span class="label">אין יציאות קרובות</span>
    {% endfor %}
  </div>
  <div class="ib-axis">
    <span class="ib-tk" style="right:0"></span><span class="ib-tl" dir="ltr" style="right:0">עכשיו</span>
    <span class="ib-tk" style="right:16.67%"></span><span class="ib-tl" dir="ltr" style="right:16.67%">+10</span>
    <span class="ib-tk" style="right:33.33%"></span><span class="ib-tl" dir="ltr" style="right:33.33%">+20</span>
    <span class="ib-tk" style="right:50%"></span><span class="ib-tl" dir="ltr" style="right:50%">+30</span>
    <span class="ib-tk" style="right:66.67%"></span><span class="ib-tl" dir="ltr" style="right:66.67%">+40</span>
    <span class="ib-tk" style="right:83.33%"></span><span class="ib-tl" dir="ltr" style="right:83.33%">+50</span>
    <span class="ib-tk" style="right:100%"></span><span class="ib-tl" dir="ltr" style="right:100%">+60</span>
  </div>
  {% if later.size > 0 %}
  <div class="ib-later">אחר כך: {% for d in later %}<span dir="ltr">{{ d.at }}</span> {{ d.line }} &nbsp;{% endfor %}</div>
  {% endif %}
</div>
<div class="title_bar ib" dir="rtl" lang="he">
  <span class="title">{{ title }}</span>
  <span class="instance">עודכן <span dir="ltr">{{ updated }}</span> · <span dir="ltr">~</span> לפי לוח זמנים</span>
</div>
{% else %}<div class="layout" dir="rtl" lang="he"><span class="label">שרת האוטובוסים לא זמין{% if error %} ({{ error }}){% endif %}</span></div>{% endif %}{% endcapture %}
